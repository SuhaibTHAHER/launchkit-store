# Copy this file to .env.local and fill in real values.

# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Required for the Paddle webhook
# to write orders/ownership (it bypasses Row Level Security on purpose).
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle Dashboard → Developer Tools → Authentication → Client-side tokens
# Not needed to run the site or test accounts — only required before accepting payments.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# "sandbox" while testing, "production" once you're ready to take real payments
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Paddle Dashboard → Developer Tools → Notifications → your webhook destination
# → signing secret (starts with pdl_ntfset_). Required for /api/webhooks/paddle
# to accept and verify events — without it, the endpoint rejects everything.
PADDLE_WEBHOOK_SECRET=

# resend.com → API Keys. Powers order-confirmation emails (src/lib/email.ts).
# Not required to run the site — without it, emails are just logged instead
# of sent, and nothing else in the purchase flow depends on it.
RESEND_API_KEY=

# Must be an address on a domain you've verified in Resend, e.g.
# "Launchkit <orders@yourdomain.com>".
EMAIL_FROM=
